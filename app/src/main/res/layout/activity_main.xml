<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <View
            android:id="@+id/dotUsageAccess"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/dot_indicator" />

        <View
            android:id="@+id/dotAccessibility"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/dot_indicator" />

        <View
            android:id="@+id/dotNotifications"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/dot_indicator" />

        <View
            android:id="@+id/dotBattery"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginHorizontal="6dp"
            android:background="@drawable/dot_indicator" />

    </LinearLayout>

    <Button
        android:id="@+id/reviewPermissionsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/review_permissions" />

    <com.selflimit.instagramtimer.view.DayScheduleView
        android:id="@+id/dayScheduleView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/editWindowsButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/edit_time_windows" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/monitorToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="@string/monitoring_toggle_label" />

</LinearLayout>
